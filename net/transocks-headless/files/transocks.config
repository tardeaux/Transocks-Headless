config transocks 'main'
	option enabled '0'
	option credential_file '/etc/transocks/credentials.json'
	option device_id ''

	# auto, ss, or trojan
	option protocol 'auto'

	# compatibility: proxy China destinations, direct otherwise
	# full: proxy all non-private destinations
	option route_mode 'compatibility'
	option geoip_cn_rule_set_url 'https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs'
	option direct_private '1'

	option core_binary '/usr/bin/sing-box'
	option run_dir '/var/run/transocks'
	option state_file '/var/run/transocks/status.json'
	# Secure persistent fallback used when provider APIs are temporarily unavailable.
	option cache_file '/etc/transocks/last-known-good.json'
	option transparent '1'
	option interrupt_connections '1'
	option tun_address '172.19.0.1/30'
	option mixed_listen '127.0.0.1:7890'
	option api_controller_listen '127.0.0.1:9090'

	option probe_url 'https://connect.rom.miui.com/generate_204'
	option test_interval '60'
	option candidate_refresh '1800'
	option refresh_timeout '90'
	option request_timeout '10'
	option retry_initial '5'
	option retry_max '900'
	option core_restart_initial '2'
	option core_restart_max '120'
	option bad_threshold_ms '1500'
	option failure_rounds '3'
	option switch_tolerance_ms '120'
	option line_count '4'
	option log_level 'info'

	list api_domain 'https://abscf2.fobwifi.com'
	list api_domain 'https://b.kolavpn.xyz'
	list api_domain 'https://b.kolavpn.win'
	list api_domain 'https://b.transmoon.xyz'
